    {
      "id": "cae36260-6ebc-4529-a63f-50426ebd4863",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i => ({ json: {\n  page_id: \"107032218841145\",\n  graph: 'https://graph.facebook.com/v26.0',\n  rupload: 'https://rupload.facebook.com/video-upload/v26.0',\n  file_url: String(i.json.media_url || '').trim(),\n  description: String(i.json.content || '').trim(),\n} }));"
      }
    },
    {
      "id": "ebef2e49-910c-4390-a33e-ebd0199e6a9a",
      "name": "Start upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build request').first().json.graph + '/' + $('Build request').first().json.page_id + '/video_reels' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookGraphApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ upload_phase: \"start\" }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "facebookGraphApi": {
          "id": "tqYldlysWaw4WwmH",
          "name": "Facebook - Dien May Toan Phat"
        }
      }
    },
    {
      "id": "94a2b4f5-8f45-4583-b809-c63bfcb0331e",
      "name": "Upload from URL",
