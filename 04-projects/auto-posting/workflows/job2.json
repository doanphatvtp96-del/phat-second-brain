    {
      "id": "480cd85a-7e1e-46ea-a56f-86704f8bfd28",
      "name": "Delivery result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "jsCode": "const MAX_ATTEMPTS = 3;\nconst stamp = DateTime.now().setZone('Asia/Ho_Chi_Minh').toISO({ suppressMilliseconds: true });\nconst sent = $('Deliver?').all(0).map(i => i.json);\nreturn $input.all().map((item, i) => {\n  const r = item.json || {};\n  const d = sent.find(x => x.delivery_id === r.delivery_id) || sent[i];\n  const row = { delivery_id: d.delivery_id, attempts: d.attempts, updated_at: stamp };\n  if (r.ok === true) return { json: { ...row, status: 'Posted', post_url: r.post_url || '', posted_at: stamp, error: '' } };\n  const error = String(r.error && r.error.message ? r.error.message : r.error || 'adapter returned no result').slice(0, 500);\n  const retry = r.retryable !== false && d.attempts < MAX_ATTEMPTS;\n  return { json: { ...row, status: retry ? 'Pending' : 'Failed', error } };\n});"
      }
    },
