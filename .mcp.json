{
  "mcpServers": {
    "n8n-mcp": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "WEBHOOK_SECURITY_MODE": "permissive",
        "N8N_API_URL": "${N8N_API_URL:-http://ps.taildae6a9.ts.net:5678}",
        "N8N_API_KEY": "${N8N_API_KEY:-}"
      }
    }
  }
}
